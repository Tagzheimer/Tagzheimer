# Tagzheimer full-stack deployment (v3 — Supabase edition)
# Copy this file to .env and edit the values.

# === Required ===
# Strong random string — used to sign device JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# === Supabase (required in production) ===
# Get these from your Supabase dashboard → Project Settings → API
#   - Project URL:           https://xxxxx.supabase.co
#   - Project API keys:
#       anon public          (safe to expose in browser — RLS protects data)
#       service_role         (full access — NEVER expose in browser; only in backend)
#   - JWT Secret:            Settings → API → JWT Settings → JWT Secret
#                            (used by the backend to verify user JWTs)
#
# In demo mode (DEMO_MODE=true) you can leave all of these blank.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# === Backend public URL ===
# The URL the browser will use to reach the backend.
# This gets baked into the frontend bundle at build time.
# Examples:
#   http://localhost:5000       (local dev)
#   https://api.tagzheimer.com   (production with TLS)
BACKEND_PUBLIC_URL=http://localhost:5000

# === Frontend URL (for CORS) ===
# The URL where the frontend is hosted. Backend allows CORS from this origin.
CLIENT_URL=http://localhost:8080

# === Demo mode ===
# Set to "true" to skip Supabase entirely and use the in-memory
# seeded store. Great for testing, NEVER use in production.
DEMO_MODE=false

# Frontend environment variables
#
# Copy this file to `.env.local` and fill in the values for your deployment.
# Vite reads .env.local automatically; .env files are NOT read in production
# builds — pass them at build time.
#
# See: https://vite.dev/guide/env-and-mode

# === Backend URL ===
# Where the Tagzheimer backend is reachable from the browser.
#   - Dev with proxy: leave empty → uses Vite dev-server proxy at /api
#   - Dev direct:     http://localhost:5000
#   - Prod:           https://api.tagzheimer.com
#
# Caregivers can override this at runtime via Profile → Backend Settings
# (stored in localStorage, takes precedence over this value).
VITE_API_URL=

# === Supabase ===
# Get these from your Supabase dashboard → Project Settings → API
#   - URL:           Project URL
#   - Anon Key:      "anon public" key (safe to expose in the browser — RLS protects data)
#
# Leave empty to use demo mode (mock-token auth + localStorage session).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === App metadata (optional) ===
VITE_APP_NAME=Tagzheimer
VITE_APP_VERSION=3.0.0
